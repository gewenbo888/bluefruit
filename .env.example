WORKSPACE_ORIGIN=https://bluefruit.psyverse.fun
WORKSPACE_TEXT_MODEL=gemini-3-flash-preview
WORKSPACE_IMAGE_ENABLED=false
# Optional JSON array of server-only keys; deduplicated with GEMINI_API_KEY
