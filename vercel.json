{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "languoduanju.psyverse.fun"
        }
      ],
      "destination": "https://bluefruit.psyverse.fun/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/platform.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "node scripts/build.cjs",
  "outputDirectory": "public",
  "framework": null
}
